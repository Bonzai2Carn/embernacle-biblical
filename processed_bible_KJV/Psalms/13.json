{
  "verses": [
    {
      "verse_num": 1,
      "segments": [
        {
          "type": "hymnal",
          "text": "How long wilt thou forget me, O LORD? for ever? how long wilt thou hide thy face from me?"
        }
      ],
      "footnotes": [
        [
          {
            "text": "+ chief…: or, overseer"
          }
        ]
      ],
      "references": [],
      "heading": []
    },
    {
      "verse_num": 2,
      "segments": [
        {
          "type": "hymnal",
          "text": "How long shall I take counsel in my soul, having sorrow in my heart daily? how long shall mine enemy be exalted over me?"
        }
      ],
      "footnotes": [],
      "references": [],
      "heading": []
    },
    {
      "verse_num": 3,
      "segments": [
        {
          "type": "hymnal",
          "text": "Consider and hear me, O LORD my God: lighten mine eyes, lest I sleep the sleep of death;"
        }
      ],
      "footnotes": [],
      "references": [],
      "heading": []
    },
    {
      "verse_num": 4,
      "segments": [
        {
          "type": "hymnal",
          "text": "Lest mine enemy say,"
        },
        {
          "type": "speech",
          "speaker": "Unknown",
          "text": "I have prevailed against him;"
        },
        {
          "type": "hymnal",
          "text": "and those that trouble me rejoice when I am moved."
        }
      ],
      "footnotes": [],
      "references": [],
      "heading": []
    },
    {
      "verse_num": 5,
      "segments": [
        {
          "type": "hymnal",
          "text": "But I have trusted in thy mercy; my heart shall rejoice in thy salvation."
        }
      ],
      "footnotes": [],
      "references": [],
      "heading": []
    },
    {
      "verse_num": 6,
      "segments": [
        {
          "type": "hymnal",
          "text": "I will sing unto the LORD, because he hath dealt bountifully with me."
        }
      ],
      "footnotes": [],
      "references": [],
      "heading": []
    }
  ]
}