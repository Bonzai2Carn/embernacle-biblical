{
  "verses": [
    {
      "verse_num": 1,
      "segments": [
        {
          "type": "hymnal",
          "text": "Many a time have they afflicted me from my youth, may Israel now say:"
        }
      ],
      "footnotes": [
        "Many: or, Much"
      ],
      "references": [],
      "heading": []
    },
    {
      "verse_num": 2,
      "segments": [
        {
          "type": "hymnal",
          "text": "Many a time have they afflicted me from my youth: yet they have not prevailed against me."
        }
      ],
      "footnotes": [
        "Many: or, Much"
      ],
      "references": [],
      "heading": []
    },
    {
      "verse_num": 3,
      "segments": [
        {
          "type": "hymnal",
          "text": "The plowers plowed upon my back: they made long their furrows."
        }
      ],
      "footnotes": [],
      "references": [],
      "heading": []
    },
    {
      "verse_num": 4,
      "segments": [
        {
          "type": "hymnal",
          "text": "The LORD is righteous: he hath cut asunder the cords of the wicked."
        }
      ],
      "footnotes": [],
      "references": [],
      "heading": []
    },
    {
      "verse_num": 5,
      "segments": [
        {
          "type": "hymnal",
          "text": "Let them all be confounded and turned back that hate Zion."
        }
      ],
      "footnotes": [],
      "references": [],
      "heading": []
    },
    {
      "verse_num": 6,
      "segments": [
        {
          "type": "hymnal",
          "text": "Let them be as the grass upon the housetops, which withereth afore it groweth up:"
        }
      ],
      "footnotes": [],
      "references": [],
      "heading": []
    },
    {
      "verse_num": 7,
      "segments": [
        {
          "type": "hymnal",
          "text": "Wherewith the mower filleth not his hand; nor he that bindeth sheaves his bosom."
        }
      ],
      "footnotes": [],
      "references": [],
      "heading": []
    },
    {
      "verse_num": 8,
      "segments": [
        {
          "type": "hymnal",
          "text": "Neither do they which go by say,"
        },
        {
          "type": "speech",
          "speaker": "Unknown",
          "text": "The blessing of the LORD be upon you: we bless you in the name of the LORD."
        }
      ],
      "footnotes": [],
      "references": [],
      "heading": []
    }
  ]
}
