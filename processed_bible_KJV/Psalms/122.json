{
  "verses": [
    {
      "verse_num": 1,
      "segments": [
        {
          "type": "hymnal",
          "text": "I was glad when they said unto me,"
        },
        {
          "type": "speech",
          "speaker": "Unknown",
          "text": "Let us go into the house of the LORD."
        }
      ],
      "footnotes": [],
      "references": [],
      "heading": [
        "A Song of Ascents. Of David"
      ]
    },
    {
      "verse_num": 2,
      "segments": [
        {
          "type": "hymnal",
          "text": "Our feet shall stand within thy gates, O Jerusalem."
        }
      ],
      "footnotes": [],
      "references": [],
      "heading": []
    },
    {
      "verse_num": 3,
      "segments": [
        {
          "type": "hymnal",
          "text": "Jerusalem is builded as a city that is compact together:"
        }
      ],
      "footnotes": [],
      "references": [],
      "heading": []
    },
    {
      "verse_num": 4,
      "segments": [
        {
          "type": "hymnal",
          "text": "Whither the tribes go up, the tribes of the LORD, unto the testimony of Israel, to give thanks unto the name of the LORD."
        }
      ],
      "footnotes": [],
      "references": [],
      "heading": []
    },
    {
      "verse_num": 5,
      "segments": [
        {
          "type": "hymnal",
          "text": "For there are set thrones of judgment, the thrones of the house of David."
        }
      ],
      "footnotes": [
        [
          {
            "text": "+ are…: Heb. do sit"
          }
        ]
      ],
      "references": [],
      "heading": []
    },
    {
      "verse_num": 6,
      "segments": [
        {
          "type": "hymnal",
          "text": "Pray for the peace of Jerusalem:"
        },
        {
          "type": "speech",
          "speaker": "Unknown",
          "text": "they shall prosper that love thee."
        }
      ],
      "footnotes": [],
      "references": [],
      "heading": []
    },
    {
      "verse_num": 7,
      "segments": [
        {
          "type": "speech",
          "speaker": "David",
          "text": "Peace be within thy walls, and prosperity within thy palaces."
        }
      ],
      "footnotes": [],
      "references": [],
      "heading": []
    },
    {
      "verse_num": 8,
      "segments": [
        {
          "type": "hymnal",
          "text": "For my brethren and companions’ sakes, I will now say,"
        },
        {
          "type": "speech",
          "speaker": "Unknown",
          "text": "Peace be within thee."
        }
      ],
      "footnotes": [],
      "references": [],
      "heading": []
    },
    {
      "verse_num": 9,
      "segments": [
        {
          "type": "hymnal",
          "text": "Because of the house of the LORD our God I will seek thy good."
        }
      ],
      "footnotes": [],
      "references": [],
      "heading": []
    }
  ]
}
