{
  "verses": [
    {
      "verse_num": 1,
      "segments": [
        {
          "type": "hymnal",
          "text": "O give thanks unto the LORD; for he is good: because his mercy endureth for ever."
        }
      ],
      "footnotes": [],
      "references": [],
      "heading": []
    },
    {
      "verse_num": 2,
      "segments": [
        {
          "type": "hymnal",
          "text": "Let Israel now say,"
        },
        {
          "type": "speech",
          "speaker": "Unknown",
          "text": "that his mercy endureth for ever."
        }
      ],
      "footnotes": [],
      "references": [],
      "heading": []
    },
    {
      "verse_num": 3,
      "segments": [
        {
          "type": "hymnal",
          "text": "Let the house of Aaron now say,"
        },
        {
          "type": "speech",
          "speaker": "Unknown",
          "text": "that his mercy endureth for ever."
        }
      ],
      "footnotes": [],
      "references": [],
      "heading": []
    },
    {
      "verse_num": 4,
      "segments": [
        {
          "type": "hymnal",
          "text": "Let them now that fear the LORD say,"
        },
        {
          "type": "speech",
          "speaker": "Unknown",
          "text": "that his mercy endureth for ever."
        }
      ],
      "footnotes": [],
      "references": [],
      "heading": []
    },
    {
      "verse_num": 5,
      "segments": [
        {
          "type": "hymnal",
          "text": "I called upon the LORD in distress: the LORD answered me, and set me in a large place."
        }
      ],
      "footnotes": [
        [
          {
            "text": "+ in distress: Heb. out of distress"
          }
        ]
      ],
      "references": [],
      "heading": []
    },
    {
      "verse_num": 6,
      "segments": [
        {
          "type": "hymnal",
          "text": "The LORD is on my side; I will not fear: what can man do unto me?"
        }
      ],
      "footnotes": [
        [
          {
            "text": "+ on…: Heb. for me"
          }
        ]
      ],
      "references": [],
      "heading": []
    },
    {
      "verse_num": 7,
      "segments": [
        {
          "type": "hymnal",
          "text": "The LORD taketh my part with them that help me: therefore shall I see my desire upon them that hate me."
        }
      ],
      "footnotes": [],
      "references": [],
      "heading": []
    },
    {
      "verse_num": 8,
      "segments": [
        {
          "type": "hymnal",
          "text": "It is better to trust in the LORD than to put confidence in man."
        }
      ],
      "footnotes": [],
      "references": [],
      "heading": []
    },
    {
      "verse_num": 9,
      "segments": [
        {
          "type": "hymnal",
          "text": "It is better to trust in the LORD than to put confidence in princes."
        }
      ],
      "footnotes": [],
      "references": [],
      "heading": []
    },
    {
      "verse_num": 10,
      "segments": [
        {
          "type": "hymnal",
          "text": "All nations compassed me about: but in the name of the LORD will I destroy them."
        }
      ],
      "footnotes": [
        [
          {
            "text": "+ destroy…: Heb. cut them off"
          }
        ]
      ],
      "references": [],
      "heading": []
    },
    {
      "verse_num": 11,
      "segments": [
        {
          "type": "hymnal",
          "text": "They compassed me about; yea, they compassed me about: but in the name of the LORD I will destroy them."
        }
      ],
      "footnotes": [],
      "references": [],
      "heading": []
    },
    {
      "verse_num": 12,
      "segments": [
        {
          "type": "hymnal",
          "text": "They compassed me about like bees; they are quenched as the fire of thorns: for in the name of the LORD I will destroy them."
        }
      ],
      "footnotes": [
        [
          {
            "text": "+ destroy: Heb. cut down"
          }
        ]
      ],
      "references": [],
      "heading": []
    },
    {
      "verse_num": 13,
      "segments": [
        {
          "type": "hymnal",
          "text": "Thou hast thrust sore at me that I might fall: but the LORD helped me."
        }
      ],
      "footnotes": [],
      "references": [],
      "heading": []
    },
    {
      "verse_num": 14,
      "segments": [
        {
          "type": "hymnal",
          "text": "The LORD is my strength and song, and is become my salvation."
        }
      ],
      "footnotes": [],
      "references": [],
      "heading": []
    },
    {
      "verse_num": 15,
      "segments": [
        {
          "type": "hymnal",
          "text": "The voice of rejoicing and salvation is in the tabernacles of the righteous:"
        },
        {
          "type": "speech",
          "speaker": "Unknown",
          "text": "the right hand of the LORD doeth valiantly."
        }
      ],
      "footnotes": [],
      "references": [],
      "heading": []
    },
    {
      "verse_num": 16,
      "segments": [
        {
          "type": "speech",
          "speaker": "Psalmist",
          "text": "The right hand of the LORD is exalted: the right hand of the LORD doeth valiantly."
        }
      ],
      "footnotes": [],
      "references": [],
      "heading": []
    },
    {
      "verse_num": 17,
      "segments": [
        {
          "type": "hymnal",
          "text": "I shall not die, but live, and declare the works of the LORD."
        }
      ],
      "footnotes": [],
      "references": [],
      "heading": []
    },
    {
      "verse_num": 18,
      "segments": [
        {
          "type": "hymnal",
          "text": "The LORD hath chastened me sore: but he hath not given me over unto death."
        }
      ],
      "footnotes": [],
      "references": [],
      "heading": []
    },
    {
      "verse_num": 19,
      "segments": [
        {
          "type": "hymnal",
          "text": "Open to me the gates of righteousness: I will go into them, and I will praise the LORD:"
        }
      ],
      "footnotes": [],
      "references": [],
      "heading": []
    },
    {
      "verse_num": 20,
      "segments": [
        {
          "type": "hymnal",
          "text": "This gate of the LORD, into which the righteous shall enter."
        }
      ],
      "footnotes": [],
      "references": [],
      "heading": []
    },
    {
      "verse_num": 21,
      "segments": [
        {
          "type": "hymnal",
          "text": "I will praise thee: for thou hast heard me, and art become my salvation."
        }
      ],
      "footnotes": [],
      "references": [],
      "heading": []
    },
    {
      "verse_num": 22,
      "segments": [
        {
          "type": "hymnal",
          "text": "The stone which the builders refused is become the head stone of the corner."
        }
      ],
      "footnotes": [],
      "references": [
        "Matthew 21:42",
        "Mark 12:10",
        "Luke 20:17",
        "Acts 4:11",
        "1 Peter 2:7"
      ],
      "heading": []
    },
    {
      "verse_num": 23,
      "segments": [
        {
          "type": "hymnal",
          "text": "This is the LORD’s doing; it is marvellous in our eyes."
        }
      ],
      "footnotes": [
        [
          {
            "text": "+ the LORD’s…: Heb. from the LORD"
          }
        ]
      ],
      "references": [],
      "heading": []
    },
    {
      "verse_num": 24,
      "segments": [
        {
          "type": "hymnal",
          "text": "This is the day which the LORD hath made; we will rejoice and be glad in it."
        }
      ],
      "footnotes": [],
      "references": [],
      "heading": []
    },
    {
      "verse_num": 25,
      "segments": [
        {
          "type": "hymnal",
          "text": "Save now, I beseech thee, O LORD: O LORD, I beseech thee, send now prosperity."
        }
      ],
      "footnotes": [],
      "references": [],
      "heading": []
    },
    {
      "verse_num": 26,
      "segments": [
        {
          "type": "hymnal",
          "text": "Blessed be he that cometh in the name of the LORD: we have blessed you out of the house of the LORD."
        }
      ],
      "footnotes": [],
      "references": [
        "Matthew 21:9",
        "Mark 11:9",
        "Luke 13:35",
        "John 12:13"
      ],
      "heading": []
    },
    {
      "verse_num": 27,
      "segments": [
        {
          "type": "hymnal",
          "text": "God is the LORD, which hath shewed us light: bind the sacrifice with cords, even unto the horns of the altar."
        }
      ],
      "footnotes": [],
      "references": [],
      "heading": []
    },
    {
      "verse_num": 28,
      "segments": [
        {
          "type": "hymnal",
          "text": "Thou art my God, and I will praise thee: thou art my God, I will exalt thee."
        }
      ],
      "footnotes": [],
      "references": [],
      "heading": []
    },
    {
      "verse_num": 29,
      "segments": [
        {
          "type": "hymnal",
          "text": "O give thanks unto the LORD; for he is good: for his mercy endureth for ever."
        }
      ],
      "footnotes": [],
      "references": [],
      "heading": []
    }
  ]
}
