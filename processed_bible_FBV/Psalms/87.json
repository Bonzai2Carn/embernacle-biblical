{
  "verses": [
    {
      "verse_num": "1",
      "segments": [
        {
          "type": "hymnal",
          "text": "The Lord founded the city on his holy mountain.\n"
        }
      ],
      "footnotes": [],
      "references": []
    },
    {
      "verse_num": "2",
      "segments": [
        {
          "type": "hymnal",
          "text": "Jerusalem is the city that the Lord loves more than any other city in Israel. "
        }
      ],
      "footnotes": [
        [
          {
            "text": "+ “Israel”: literally, Jacob."
          }
        ]
      ],
      "references": []
    },
    {
      "verse_num": "3",
      "segments": [
        {
          "type": "hymnal",
          "text": "Many wonderful things are said of you, city of God! Selah."
        }
      ],
      "footnotes": [],
      "references": []
    },
    {
      "verse_num": "4",
      "segments": [
        {
          "type": "hymnal",
          "text": "I mention Egypt and Babylon as those who know me, and in addition Philistia, Tyre, and Ethiopia—"
        },
        {
          "type": "divine",
          "text": "this man was born there.",
          "speaker": "The Lord"
        }
      ],
      "footnotes": [
        [
          {
            "text": "+ Literally, “Rahab.”"
          }
        ],
        [
          {
            "text": "+ The meaning of this verse is debated. What it seems to be saying is that despite the patriotism for each country/city mentioned, the best is to be born in Jerusalem. (See following verse.)"
          }
        ]
      ],
      "references": []
    },
    {
      "verse_num": "5",
      "segments": [
        {
          "type": "hymnal",
          "text": "It will be said concerning Jerusalem,"
        },
        {
          "type": "divine",
          "text": "Everyone was born there,",
          "speaker": "The Lord"
        },
        {
          "type": "hymnal",
          "text": "and the Most High will make it secure."
        }
      ],
      "footnotes": [
        [
          {
            "text": "+ In other words, everyone will have the right to citizenship in Jerusalem."
          }
        ]
      ],
      "references": []
    },
    {
      "verse_num": "6",
      "segments": [
        {
          "type": "hymnal",
          "text": "When the Lord registers the nations, he will write,"
        },
        {
          "type": "divine",
          "text": "They were born there.",
          "speaker": "The Lord"
        },
        {
          "type": "hymnal",
          "text": "Selah."
        }
      ],
      "footnotes": [
        [
          {
            "text": "+ In Jerusalem."
          }
        ]
      ],
      "references": []
    },
    {
      "verse_num": "7",
      "segments": [
        {
          "type": "hymnal",
          "text": "Singers and dancers alike say,"
        },
        {
          "type": "speech",
          "text": "Living here I am at home.",
          "speaker": "Singers and pipers"
        }
      ],
      "footnotes": [
        [
          {
            "text": "+ Literally, “All of my springs are in you.”"
          }
        ]
      ],
      "references": []
    }
  ]
}
